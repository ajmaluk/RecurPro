# MySQL Database Configuration
# Set these to your MySQL instance credentials (local, XAMPP, Docker, or remote MySQL host)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=brightloop

# Authentication JWT Secret
JWT_SECRET=brightloop_jwt_secret_key_2026_super_secure

# Backend Server Port
PORT=3001

# Frontend Convex URL (retained for backward compatibility)
VITE_CONVEX_URL=https://placeholder-app.convex.cloud
CONVEX_SITE_URL=http://localhost:5173
